/* Open//77 ALT context menu on NativeUI.
   The accent colour is applied by client/ui.lua as a named stylesheet layer
   ("accent"): every rule below that uses #18d6e7 is its default.
   1 dp = 1 px of the 1080p reference; positions set from Lua are in px. */

body { width: 100%; height: 100%; pointer-events: none; font-family: "Chakra Petch"; font-weight: bold; color: #e6eaec; }
#stage { position: absolute; left: 0; top: 0; right: 0; bottom: 0; pointer-events: none; }

/* the whole screen takes the clicks while the menu is open: a click anywhere picks */
#hit { position: absolute; left: 0; top: 0; right: 0; bottom: 0; pointer-events: auto; cursor: default; }

/* a soft darkening at the edges, so the panel and the reticle read on any scene */
#vignette
{
    position: absolute; left: 0; top: 0; right: 0; bottom: 0; pointer-events: none;
    decorator: radial-gradient(circle, #00000000 60%, #02040a59 100%);
    opacity: 0; transition: opacity 0.25s cubic-out;
}
#stage.open #vignette { opacity: 1; }

/* ---- the reticle --------------------------------------------------------------- */
#reticle
{
    position: absolute; left: 50%; top: 50%;
    width: 46dp; height: 46dp; margin-left: -23dp; margin-top: -23dp;
    pointer-events: none; opacity: 0;
}
.br { position: absolute; width: 11dp; height: 11dp; border-color: #e6eaecd9; transition: border-color 0.14s linear-in-out; }
.br.tl  { left: 0; top: 0; border-left-width: 2dp; border-top-width: 2dp; }
.br.tr  { right: 0; top: 0; border-right-width: 2dp; border-top-width: 2dp; }
.br.bl  { left: 0; bottom: 0; border-left-width: 2dp; border-bottom-width: 2dp; }
.br.brr { right: 0; bottom: 0; border-right-width: 2dp; border-bottom-width: 2dp; }
#stage.available .br { border-color: #18d6e7; }
#ring { position: absolute; left: 7dp; top: 7dp; width: 32dp; height: 32dp; opacity: 0; transition: opacity 0.15s cubic-out; }
.ring-shape { position: absolute; left: 0; top: 0; width: 32dp; height: 32dp; fill: #00000000; stroke: #18d6e7; stroke-width: 2dp; stroke-dasharray: 18 9; }
#stage.loading #ring { opacity: 1; }
#dot { position: absolute; left: 20dp; top: 20dp; width: 6dp; height: 6dp; background-color: #e6eaec; transform: rotate(45deg); opacity: 0; transition: opacity 0.12s linear-in-out, background-color 0.14s linear-in-out; }
#stage.locked #dot { opacity: 1; }
#stage.available #dot { background-color: #18d6e7; }

/* ---- the panel ------------------------------------------------------------------ */
/* display, not opacity, hides it: a backdrop filter still draws at opacity 0 */
#panel
{
    display: none;
    position: absolute; left: 0; top: 0;
    width: 272dp;
    pointer-events: auto; cursor: default;
    background-color: #060a11e0;
    backdrop-filter: blur(12dp) saturate(1.15);
    border-left-width: 2dp; border-color: #18d6e7;
    box-shadow: #000000a6 0dp 10dp 30dp 0dp;
}
#panel.shown { display: block; }

#head { display: flex; flex-direction: row; align-items: center; height: 32dp; padding: 0 10dp 0 0; border-bottom-width: 1dp; border-color: #ffffff12; }
#kind { height: 32dp; padding: 0 12dp 0 10dp; margin-right: 10dp; background-color: #18d6e7; flex-shrink: 0; }
#kind span { font-size: 10dp; line-height: 32dp; letter-spacing: 0.2em; color: #04080d; text-transform: uppercase; }
#title { flex: 1 1 auto; overflow: hidden; }
#title span { font-size: 12dp; letter-spacing: 0.1em; color: #f2f5f7; white-space: nowrap; text-transform: uppercase; }
#dist { display: none; flex-shrink: 0; margin-left: 8dp; }
#dist.on { display: block; }
#dist span { font-family: "Roboto Mono"; font-size: 11dp; color: #8a94a2; }

/* a scan line under the header while the target is looked up */
#sweep { position: relative; height: 2dp; overflow: hidden; background-color: #ffffff08; }
#sweep-bar { position: absolute; left: 0; top: 0; width: 34%; height: 2dp; background-color: #18d6e7; opacity: 0; filter: glow(4dp #18d6e7 1); }
#stage.loading #sweep-bar { opacity: 1; }

#status { display: none; flex-direction: row; align-items: center; padding: 10dp 12dp; }
#status.on { display: flex; }
#status-tag { height: 16dp; padding: 0 6dp; margin-right: 9dp; background-color: #8a94a240; transform: skewX(-14deg); flex-shrink: 0; }
#status-tag span { font-size: 10dp; line-height: 16dp; letter-spacing: 0.14em; color: #c7ced8; }
#status-text { font-size: 11dp; letter-spacing: 0.06em; color: #a3adb9; }
#panel.error #status-tag { background-color: #ff3b4e; filter: glow(5dp #ff3b4e 0.8); }
#panel.error #status-tag span { color: #1a0306; }
#panel.error #status-text { color: #ff8a96; }

#rows { display: block; max-height: 384dp; overflow-y: auto; padding: 4dp 0 4dp 0; }
#rows scrollbarvertical { width: 3dp; }
#rows scrollbarvertical sliderbar { background-color: #18d6e799; }

.grp { display: block; padding: 9dp 12dp 3dp 12dp; }
.grp span { font-size: 9dp; letter-spacing: 0.24em; color: #6e7886; text-transform: uppercase; }

.row
{
    display: flex; flex-direction: row; align-items: center;
    height: 32dp; padding: 0 12dp 0 10dp; margin: 1dp 4dp 1dp 0dp;
    border-left-width: 2dp; border-color: #00000000;
    background-color: #00000000;
    cursor: pointer;
    transition: background-color border-color padding-left 0.14s cubic-out;
}
.row .ic { position: relative; width: 18dp; height: 18dp; margin-right: 11dp; flex-shrink: 0; }
.row .ic path { position: absolute; left: 0; top: 0; width: 18dp; height: 18dp; fill: #00000000; stroke: #c7ced8; stroke-width: 1.6dp; stroke-linecap: round; stroke-linejoin: round; }
.row .spin { display: none; position: absolute; left: 1dp; top: 1dp; width: 16dp; height: 16dp; fill: #00000000; stroke: #18d6e7; stroke-width: 2dp; stroke-dasharray: 14 10; }
.row .lb { flex: 1 1 auto; font-size: 12.5dp; letter-spacing: 0.04em; color: #dfe4ea; white-space: nowrap; }
.row .go { flex-shrink: 0; width: 8dp; height: 8dp; margin-left: 8dp; border-right-width: 2dp; border-top-width: 2dp; border-color: #18d6e7; transform: rotate(45deg); opacity: 0; transition: opacity 0.12s cubic-out; }

.row.focus { background-color: #18d6e72e; border-color: #18d6e7; padding-left: 14dp; }
.row.focus .lb { color: #ffffff; }
.row.focus .ic path { stroke: #18d6e7; }
.row.focus .go { opacity: 1; }

.row.danger .lb { color: #ff7b88; }
.row.danger .ic path { stroke: #ff7b88; }
.row.danger.focus { background-color: #ff3b4e2e; border-color: #ff3b4e; }
.row.danger.focus .ic path { stroke: #ff3b4e; }
.row.danger .go { border-color: #ff3b4e; }

.row.pending .ic path { display: none; }
.row.pending .spin { display: block; }
#panel.busy .row { cursor: default; }
#panel.busy .row.idle { opacity: 0.45; }

/* the focused row's description, under the list */
#desc { display: none; padding: 7dp 12dp 8dp 12dp; border-top-width: 1dp; border-color: #ffffff0f; }
#desc.on { display: block; }
#desc span { font-family: "Lato"; font-weight: normal; font-size: 11dp; line-height: 15dp; color: #a3adb9; }

#foot { display: flex; flex-direction: row; align-items: center; height: 22dp; padding: 0 10dp; border-top-width: 1dp; border-color: #ffffff0f; }
.fk { font-family: "Roboto Mono"; font-size: 9dp; color: #c7ced8; margin-right: 4dp; }
.ft { font-size: 8.5dp; letter-spacing: 0.18em; color: #5a6472; margin-right: 11dp; }
#panel.empty #foot { display: none; }

/* ---- the hint bar ---------------------------------------------------------------- */
#hintbar
{
    position: absolute; left: 0; right: 0; bottom: 96dp;
    display: flex; flex-direction: row; justify-content: center; align-items: center;
    pointer-events: none; opacity: 0;
}
#hint-key { height: 20dp; padding: 0 8dp; margin-right: 10dp; background-color: #18d6e7; transform: skewX(-14deg); }
#hint-key span { font-size: 10dp; line-height: 20dp; letter-spacing: 0.16em; color: #04080d; }
.hint-text { font-size: 10dp; letter-spacing: 0.24em; color: #c7ced8; text-transform: uppercase; font-effect: shadow(0dp 1dp #000000); }
